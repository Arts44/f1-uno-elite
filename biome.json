{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules/**",
      "!.claude/**",
      "!.github/**",
      "!app/app.bundle.js",
      "!app/app.bundle.js.map",
      "!package-lock.json",
      "!_*",
      "!app/qrcodegen.js",
      "!app/data-embedded.js",
      "!screenshots/**",
      "!app/icons/**",
      "!app/fonts/**",
      "!docs/email-templates/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "off",
        "useTemplate": "off",
        "noUselessElse": "off",
        "useConst": "warn"
      },
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error"
      }
    }
  }
}

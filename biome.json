{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules/**",
      "!.claude/**",
      "!.github/**",
      "!app.bundle.js",
      "!app.bundle.js.map",
      "!package-lock.json",
      "!_*",
      "!qrcodegen.js",
      "!data-embedded.js",
      "!screenshots/**",
      "!icons/**",
      "!fonts/**",
      "!docs/email-templates/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "off",
        "useTemplate": "off",
        "noUselessElse": "off",
        "useConst": "warn"
      },
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error"
      }
    }
  }
}
